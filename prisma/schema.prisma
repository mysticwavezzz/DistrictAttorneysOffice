generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  discordUserId    String?  @unique
  robloxUserId     String?  @unique
  username         String
  displayName      String
  avatarUrl        String?
  tiers            String   @default("")
  division         String?
  mutedTypes       String   @default("")
  pushMutedTypes   String   @default("")
  savedCaseFilters String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  accounts             Account[]
  sessions             Session[]
  assignedCases        Case[]              @relation("AssignedAttorney")
  createdCases         Case[]              @relation("CreatedBy")
  createdAnnouncements Announcement[]      @relation("CreatedAnnouncements")
  filingsAdded         CaseFiling[]        @relation("FilingsAdded")
  commentsAuthored     CaseComment[]       @relation("CommentsAuthored")
  requestsSubmitted    CaseActionRequest[] @relation("RequestsSubmitted")
  requestsReviewed     CaseActionRequest[] @relation("RequestsReviewed")
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  contactTickets      ContactTicket[] @relation("ContactTicketRequester")
  assignedContactTickets ContactTicket[] @relation("ContactTicketAssignee")
  contactMessages     ContactMessage[]
  deadlineReminders    DeadlineReminder[]
  aopcsSubmitted       Aopc[]              @relation("AopcSubmitted")
  aopcsReviewed        Aopc[]              @relation("AopcReviewed")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Case {
  id                 String    @id @default(cuid())
  caseNumber         String    @unique
  title              String
  type               String?
  stage              String?
  disclosures        String?
  partyDetails       String    @default("[]")
  assignedJudge      String?
  discGiven          DateTime?
  discDue            DateTime?
  pretrial           DateTime?
  otherDates         String?
  outcome            String?
  closedOn           DateTime?
  appealBy           DateTime?
  arraignmentAt      DateTime?
  proofOfServiceAt   DateTime?
  discoveryOrderAt   DateTime?
  discoveryRequestedAt DateTime?
  motionServedAt      DateTime?
  verdictAt          DateTime?
  sentenceAt         DateTime?
  finalJudgmentAt    DateTime?
  archived           Boolean   @default(false)
  isDraft            Boolean   @default(false)
  summary            String
  division           String?
  assignedAttorneyId String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedAttorney  User?               @relation("AssignedAttorney", fields: [assignedAttorneyId], references: [id])
  createdBy         User                @relation("CreatedBy", fields: [createdById], references: [id])
  filings           CaseFiling[]
  comments          CaseComment[]
  actionRequests    CaseActionRequest[]
  relatedTo         Case[]              @relation("CaseRelations")
  relatedFrom       Case[]              @relation("CaseRelations")
  aopcs             Aopc[]
  deadlineReminders DeadlineReminder[]

  @@index([archived])
}

model CaseFiling {
  id        String   @id @default(cuid())
  caseId    String
  title     String
  url       String?
  pdfData   String?
  pdfFileName String?
  addedById String
  createdAt DateTime @default(now())

  case    Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  addedBy User @relation("FilingsAdded", fields: [addedById], references: [id])
}

model CaseComment {
  id        String   @id @default(cuid())
  caseId    String
  body      String
  isSystem  Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())

  case   Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User? @relation("CommentsAuthored", fields: [authorId], references: [id])
}

model CaseActionRequest {
  id            String    @id @default(cuid())
  kind          String
  caseId        String?
  status        String    @default("PENDING")
  proposedData  String
  division      String?
  requestedById String
  reviewedById  String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  case        Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("RequestsSubmitted", fields: [requestedById], references: [id])
  reviewedBy  User? @relation("RequestsReviewed", fields: [reviewedById], references: [id])

  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ContactTicket {
  id           String   @id @default(cuid())
  subject      String
  status       String   @default("OPEN")
  division     String?
  requesterId  String
  assigneeId   String?
  heldAt       DateTime?
  closedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requester User  @relation("ContactTicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee  User? @relation("ContactTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages  ContactMessage[]

  @@index([requesterId, status, updatedAt])
  @@index([assigneeId, status, updatedAt])
  @@index([status, updatedAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket ContactTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model DeadlineReminder {
  id             String    @id @default(cuid())
  userId         String
  caseId         String
  deadlineType   String
  dueDate        DateTime
  acknowledgedAt DateTime?
  snoozedUntil   DateTime?
  lastNotifiedAt DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId, deadlineType, dueDate])
  @@index([userId, acknowledgedAt, snoozedUntil])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  summary     String?
  body        String
  imageUrl    String?
  pdfData     String?
  pdfFileName String?
  audience    String   @default("PUBLIC")
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  createdById String?

  createdBy User? @relation("CreatedAnnouncements", fields: [createdById], references: [id])

  @@index([audience, isPublished, publishedAt])
}

model RosterEntry {
  id            String    @id @default(cuid())
  name          String
  discordUserId String?
  robloxUserId  String?   @unique
  robloxSynced  Boolean   @default(false)
  robloxRoleId  String?
  robloxRank    Int?
  lastRobloxSyncAt DateTime?
  rank          String?
  unit          String?
  imageUrl      String?
  about         String?
  startDate     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model RobloxRosterSyncRun {
  id             String   @id @default(cuid())
  actorName      String
  groupId        String
  status         String   @default("PREVIEW")
  previewData    String
  additions      Int      @default(0)
  updates        Int      @default(0)
  inactivations  Int      @default(0)
  exceptions     Int      @default(0)
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  appliedAt      DateTime?

  @@index([createdAt])
  @@index([status, expiresAt])
}

model Aopc {
  id            String    @id @default(cuid())
  title         String
  reportId      String?
  targetUnit    String
  subject       String
  narrative     String
  documentUrl   String?
  pdfData       String?
  pdfFileName   String?
  status        String    @default("PENDING")
  submittedById String
  reviewedById  String?
  reviewNote    String?
  reviewedAt    DateTime?
  linkedCaseId  String?
  createdAt     DateTime  @default(now())

  submittedBy User  @relation("AopcSubmitted", fields: [submittedById], references: [id])
  reviewedBy  User? @relation("AopcReviewed", fields: [reviewedById], references: [id])
  linkedCase  Case? @relation(fields: [linkedCaseId], references: [id])

  @@index([status])
}

model ActivityLog {
  id          String   @id @default(cuid())
  actorName   String
  action      String
  targetType  String
  targetLabel String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model RecordsRequest {
  id        String   @id @default(cuid())
  name      String
  contact   String
  details   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model SiteSettings {
  id                      Int       @id @default(1)
  maintenanceMode         Boolean   @default(false)
  maintenanceMessage      String?
  maintenanceEstimatedAt  DateTime?
  maintenanceTimeZone     String    @default("legacy-utc")
  notificationsDisabled   Boolean   @default(false)
  deadlineReminderDays    String    @default("7,3,1")
  overdueRemindersEnabled Boolean   @default(true)
  updatedAt               DateTime  @updatedAt
}

model SiteConfiguration {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime
}

// Stores only the public receipt and delivery state, never report contents or identities.
model TipSubmission {
  reference String   @id
  status    String   @default("IN_PROGRESS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrimeTipBlacklist {
  id            String   @id @default(cuid())
  kind          String
  identifier    String
  identifierKey String   @unique
  reason        String
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([kind, identifierKey])
}

model SettingsAuditLog {
  id        String   @id @default(cuid())
  actorName String
  action    String
  details   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ActionDebugLog {
  id               String   @id @default(cuid())
  actionId         String   @unique
  actionName       String
  actorId          String?
  actorName        String?
  identityProvider String?
  requestMethod    String?
  requestPath      String?
  permissionTiers  String   @default("[]")
  outcome          String
  startedAt        DateTime
  durationMs       Int
  targetReference  String?
  errorName        String?
  errorStack       String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([actorName, createdAt])
  @@index([actionName, createdAt])
  @@index([outcome, createdAt])
}

model ConfigurationBackup {
  id        String   @id @default(cuid())
  actorName String
  payload   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
