generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  discordUserId    String   @unique
  username         String
  displayName      String
  avatarUrl        String?
  tiers            String   @default("")
  mutedTypes       String   @default("")
  savedCaseFilters String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  accounts             Account[]
  sessions             Session[]
  assignedCases        Case[]              @relation("AssignedAttorney")
  createdCases         Case[]              @relation("CreatedBy")
  createdAnnouncements Announcement[]      @relation("CreatedAnnouncements")
  filingsAdded         CaseFiling[]        @relation("FilingsAdded")
  commentsAuthored     CaseComment[]       @relation("CommentsAuthored")
  requestsSubmitted    CaseActionRequest[] @relation("RequestsSubmitted")
  requestsReviewed     CaseActionRequest[] @relation("RequestsReviewed")
  notifications        Notification[]
  deadlineReminders    DeadlineReminder[]
  aopcsSubmitted       Aopc[]              @relation("AopcSubmitted")
  aopcsReviewed        Aopc[]              @relation("AopcReviewed")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Case {
  id                 String    @id @default(cuid())
  caseNumber         String    @unique
  title              String
  type               String?
  stage              String?
  disclosures        String?
  discGiven          DateTime?
  discDue            DateTime?
  pretrial           DateTime?
  otherDates         String?
  outcome            String?
  closedOn           DateTime?
  appealBy           DateTime?
  archived           Boolean   @default(false)
  isDraft            Boolean   @default(false)
  summary            String
  assignedAttorneyId String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedAttorney  User?               @relation("AssignedAttorney", fields: [assignedAttorneyId], references: [id])
  createdBy         User                @relation("CreatedBy", fields: [createdById], references: [id])
  filings           CaseFiling[]
  comments          CaseComment[]
  actionRequests    CaseActionRequest[]
  relatedTo         Case[]              @relation("CaseRelations")
  relatedFrom       Case[]              @relation("CaseRelations")
  aopcs             Aopc[]
  deadlineReminders DeadlineReminder[]

  @@index([archived])
}

model CaseFiling {
  id        String   @id @default(cuid())
  caseId    String
  title     String
  url       String
  addedById String
  createdAt DateTime @default(now())

  case    Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  addedBy User @relation("FilingsAdded", fields: [addedById], references: [id])
}

model CaseComment {
  id        String   @id @default(cuid())
  caseId    String
  body      String
  isSystem  Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())

  case   Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User? @relation("CommentsAuthored", fields: [authorId], references: [id])
}

model CaseActionRequest {
  id            String    @id @default(cuid())
  kind          String
  caseId        String?
  status        String    @default("PENDING")
  proposedData  String
  requestedById String
  reviewedById  String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  case        Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("RequestsSubmitted", fields: [requestedById], references: [id])
  reviewedBy  User? @relation("RequestsReviewed", fields: [reviewedById], references: [id])

  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model DeadlineReminder {
  id             String    @id @default(cuid())
  userId         String
  caseId         String
  deadlineType   String
  dueDate        DateTime
  acknowledgedAt DateTime?
  snoozedUntil   DateTime?
  lastNotifiedAt DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId, deadlineType, dueDate])
  @@index([userId, acknowledgedAt, snoozedUntil])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  summary     String?
  body        String
  imageUrl    String?
  audience    String   @default("PUBLIC")
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  createdById String?

  createdBy User? @relation("CreatedAnnouncements", fields: [createdById], references: [id])

  @@index([audience, isPublished, publishedAt])
}

model RosterEntry {
  id            String    @id @default(cuid())
  name          String
  discordUserId String?
  rank          String?
  unit          String?
  imageUrl      String?
  about         String?
  startDate     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Aopc {
  id            String    @id @default(cuid())
  title         String
  reportId      String?
  targetUnit    String
  subject       String
  narrative     String
  documentUrl   String?
  pdfData       String?
  pdfFileName   String?
  status        String    @default("PENDING")
  submittedById String
  reviewedById  String?
  reviewNote    String?
  reviewedAt    DateTime?
  linkedCaseId  String?
  createdAt     DateTime  @default(now())

  submittedBy User  @relation("AopcSubmitted", fields: [submittedById], references: [id])
  reviewedBy  User? @relation("AopcReviewed", fields: [reviewedById], references: [id])
  linkedCase  Case? @relation(fields: [linkedCaseId], references: [id])

  @@index([status])
}

model ActivityLog {
  id          String   @id @default(cuid())
  actorName   String
  action      String
  targetType  String
  targetLabel String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model RecordsRequest {
  id        String   @id @default(cuid())
  name      String
  contact   String
  details   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model SiteSettings {
  id                      Int       @id @default(1)
  maintenanceMode         Boolean   @default(false)
  maintenanceMessage      String?
  maintenanceEstimatedAt  DateTime?
  maintenanceTimeZone     String    @default("legacy-utc")
  notificationsDisabled   Boolean   @default(false)
  deadlineReminderDays    String    @default("7,3,1")
  overdueRemindersEnabled Boolean   @default(true)
  updatedAt               DateTime  @updatedAt
}

model SiteConfiguration {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime
}

model CrimeTipBlacklist {
  id            String   @id @default(cuid())
  kind          String
  identifier    String
  identifierKey String   @unique
  reason        String
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([kind, identifierKey])
}

model SettingsAuditLog {
  id        String   @id @default(cuid())
  actorName String
  action    String
  details   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ConfigurationBackup {
  id        String   @id @default(cuid())
  actorName String
  payload   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
