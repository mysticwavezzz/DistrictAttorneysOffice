# Copy this file to .env.local and fill in real values before running the
# app. See src/lib/env.ts for validation rules.

# --- Auth.js -----------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Only needed in production behind a proxy/custom domain, e.g. https://da.example.com
AUTH_URL=

# --- Roblox OAuth2 -------------------------------------------------------
# Create an OAuth2 app at https://create.roblox.com/dashboard/credentials
# Redirect URI to register there: <AUTH_URL or http://localhost:3000>/api/auth/callback/roblox
# Scopes requested: openid profile
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# --- Database ------------------------------------------------------------
# Local dev (SQLite):
DATABASE_URL="file:./dev.db"
# Production (Postgres), after updating prisma/schema.prisma's datasource provider:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Permission tier <-> Roblox group mapping ----------------------------
# Numeric Roblox group IDs. Omit any of these to disable that tier entirely
# (see src/config/role-mappings.ts for how they're used).
ROBLOX_LAW_ENFORCEMENT_GROUP_ID=
ROBLOX_GOVERNMENT_GROUP_ID=
ROBLOX_DA_GROUP_ID=

# --- Criminal tips Google Form --------------------------------------------
# The form's formResponse endpoint, e.g.
# https://docs.google.com/forms/d/e/<form-id>/formResponse
GOOGLE_FORM_ACTION_URL=
# Entry field IDs from the form's prefilled-link HTML (entry.123456789).
# Only GOOGLE_FORM_ENTRY_DETAILS is required; the others are optional.
GOOGLE_FORM_ENTRY_NAME=
GOOGLE_FORM_ENTRY_CONTACT=
GOOGLE_FORM_ENTRY_LOCATION=
GOOGLE_FORM_ENTRY_DETAILS=

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="District Attorney's Office"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
