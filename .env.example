# Copy this file to .env.local and fill in real values before running the
# app. See src/lib/env.ts for validation rules.

# --- Auth.js -----------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Only needed in production behind a proxy/custom domain, e.g. https://da.example.com
AUTH_URL=

# --- Discord OAuth2 -------------------------------------------------------
# Discord Developer Portal (discord.com/developers/applications) > your app
# Redirect URI to register (OAuth2 tab): <AUTH_URL or http://localhost:3000>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot tab > Token. The bot must be a member of DISCORD_GUILD_ID.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# --- Database ------------------------------------------------------------
# Local dev (SQLite):
DATABASE_URL="file:./dev.db"
# Production on Railway: mount a Volume on the service (Settings > Volumes,
# e.g. mount path /data) and point this at a file inside it, so the
# database survives redeploys instead of living in the ephemeral container
# filesystem:
# DATABASE_URL="file:/data/prod.db"

# Permission tier <-> role mapping lives in src/config/discord-role-mappings.ts (edit directly, no env vars).

# --- Criminal tips Google Form --------------------------------------------
# The form's formResponse endpoint, e.g.
# https://docs.google.com/forms/d/e/<form-id>/formResponse
GOOGLE_FORM_ACTION_URL=
# Entry field IDs from the form's prefilled-link HTML (entry.123456789).
# Only GOOGLE_FORM_ENTRY_DETAILS is required; the others are optional.
GOOGLE_FORM_ENTRY_NAME=
GOOGLE_FORM_ENTRY_CONTACT=
GOOGLE_FORM_ENTRY_LOCATION=
GOOGLE_FORM_ENTRY_DETAILS=

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="District Attorney's Office"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
